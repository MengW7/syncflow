# Compose 里的 API / Worker 使用 MYSQL_HOST=mysql 和 REDIS_ADDR=redis:6379。
# 在宿主机跑 API 和 Worker 时，把这两项改成 127.0.0.1 和 127.0.0.1:6379。
# 不要把宿主机的 UPLOAD_DIR 写进这个文件。Compose 使用默认 /data/uploads，对应卷 ./uploads。
# 宿主机进程请在各自终端里设置 UPLOAD_DIR，不要和 Compose Worker 同时消费 syncflow:jobs。

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=syncflow
MYSQL_USER=syncflow
MYSQL_PASSWORD=syncflow123
MYSQL_ROOT_PASSWORD=root
MYSQL_TEST_DATABASE=syncflow_test

REDIS_ADDR=redis:6379

# 上传上限，单位 MB。文件字节数等于该值时可以创建，多 1 字节返回 FILE_TOO_LARGE。
MAX_UPLOAD_FILE_SIZE_MB=10
# 单个任务的有效数据行上限。空行不计。等于该值可以通过，多一行是 FILE_TOO_MANY_ROWS。
# Worker 启动时读取。现场演示如果改过它，结束后改回 10000 再跑测试。
MAX_RECORDS_PER_JOB=10000

WORKER_CONCURRENCY=2
# Worker 启动时回收超时仍为 RUNNING 的任务，单位秒。
JOB_TIMEOUT_SECONDS=300
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
# 下面三项 V1.0 不接入，保留给后续重试和幂等。
MAX_JOB_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=5,30,120
IDEMPOTENCY_KEY_TTL_HOURS=24

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
